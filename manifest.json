{
  "manifest_version": 3,
  "name": "AppAI Browser Debug",
  "version": "0.1.0",
  "description": "Lets the AppAI coding agent (appai CLI) inspect and debug pages in tabs it opens, using your logged-in session.",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "tabGroups", "nativeMessaging", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "AppAI Browser Debug" }
}
